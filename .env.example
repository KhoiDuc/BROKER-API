# Supabase Postgres — pooler (port 6543) for serverless runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Postgres — direct (port 5432) for migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Legacy server-side Bearer token (seed/curl only — NOT for Blazor frontend)
API_KEY="change-me-to-a-long-random-string"

# Trading login (Blazor Broker desk)
TRADING_USERNAME="trader"
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# Use single quotes so $ in bcrypt hash is not expanded
TRADING_PASSWORD_HASH='$2a$10$replace-with-bcrypt-hash'
JWT_SECRET="change-me-to-a-long-random-jwt-secret"
JWT_EXPIRES_IN="7d"

# Blazor origins (CORS) — comma-separated, no path. GitHub Pages uses the host origin.
ALLOWED_ORIGINS="https://khoinguyenminhduc.github.io,https://khoiduc.github.io,http://localhost:5288,http://localhost:5000"

# TCBS OpenAPI proxy. API key and JWT are encrypted with this key. Never put the TCBS API key here.
TCBS_ENC_KEY="change-me-to-a-long-random-string"
TCBS_MAX_ORDER_VND="500000000"
# Optional websocket relay (Cloudflare worker cloudflare/tcbs-ws-relay.js)
TCBS_RELAY_URL=""
TCBS_RELAY_SECRET=""

# Server-side Gemini. The browser never sees this key.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Vercel Cron calls /api/cron/* with Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
